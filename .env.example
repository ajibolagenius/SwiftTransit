# Copy to .env (gitignored). EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# Supabase project: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Map styles (optional, default to OpenFreeMap positron / dark)
# EXPO_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# EXPO_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Development only: pretend to be signed in as this role (ignored in release builds)
# EXPO_PUBLIC_DEV_AUTH_STUB=customer

# OAuth app client IDs for Google and Apple sign-in (public values; the secrets stay in Supabase).
# Google: the OAuth 2.0 Web client ID from Google Cloud Console.
# Apple: the Services ID from your Apple Developer account.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_APPLE_CLIENT_ID=com.example.swifttransit.services

# Supabase dashboard settings this feature needs (set once, not in git):
# - Auth > Providers: Phone, Email, Google, Apple enabled
# - Auth > URL Configuration: Site URL + Redirect URLs including swifttransit://auth/callback
# - Auth > Sign In / Up: "Confirm email" OFF, "One user per confirmed email" ON
# - Auth > Rate Limits: OTP expiry 120 s; CAPTCHA on OTP endpoints
# - Auth > SMS: Hook URL -> https://<project-ref>.functions.supabase.co/send-sms
#   with header Authorization: Bearer <SEND_SMS_HOOK_SECRET>; test OTP codes for demo numbers
#
# Edge Function secrets (set with `supabase secrets set`, never committed here):
#   TERMII_API_KEY, TERMII_SENDER_ID, SEND_SMS_HOOK_SECRET, DEMO_PHONE_NUMBERS
